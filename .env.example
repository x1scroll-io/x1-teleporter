# Copy these into Vercel → Project → Settings → Environment Variables.
# Do NOT commit a real .env — this file is just the template.

# Your registered LI.FI integrator string (from portal.li.fi).
INTEGRATOR=x1-teleporter-labs

# Integrator fee as a float. 0.01 = 1%. LI.FI max is 0.10 (10%).
INTEGRATOR_FEE=0.01

# Optional: LI.FI API key — raises rate limit from 200/2h to 200/min.
LIFI_API_KEY=

# Fee payout wallets. EVM-settled fees go to the EVM address; Solana/X1-settled
# fees go to the SVM address. Used by the withdraw flow (server never signs).
FEE_WALLET_EVM=
FEE_WALLET_SVM=
VITE_SOLANA_RPC=https://your-solana-mainnet-rpc-here

# Rango aggregator (Phase-5 scaffold) — the multi-chain lane (SUI/TRON/XRPL +
# UTXO-native fallback when THORChain halts). The key is appended SERVER-side
# as the apiKey query param by api/rango/quote.js (never a VITE_ var — it
# would compile into the browser bundle). Key request: Rango's Discord
# (users-support channel) — docs.rango.exchange/api-integration/api-key-and-rate-limits.
# NOTE: the docs' PUBLIC TEST key (c6381a79-2817-4602-83bf-6a641a409e32) only
# works against the public-api host — set RANGO_API_URL=https://public-api.rango.exchange
# for trials with it. No key set → the proxy fails closed (502 no_api_key).
RANGO_API_KEY=
RANGO_API_URL=https://api.rango.exchange

# Wanchain-family lane (XFlows v3 scaffold — VERIFIED 2026-09-05): the upstream
# (xflows.wanchain.org) is KEYLESS today, so api/wanchain/quote.js needs no key.
# This override exists for the day Wanchain ships a keyed host or a testnet
# mirror — set it server-side ONLY (never a VITE_ var). Unset → the default
# https://xflows.wanchain.org is used. COVERAGE TRUTH: the quote API serves
# EVM-chain pairs only; Cardano/Sui/Polkadot routes all failed live probes
# (evidence: test/fixtures/golden/wanchain-leg/VERIFICATION-2026-09-05.json).
WANCHAIN_API_URL=

# Feature flags (all default to false when unset).
# Preview: shows the THORChain tab lane inside the v2 card (visibility only —
# send paths stay behind WARP_LIVE_SEND=false; no live sends).
NEXT_PUBLIC_FLAG_THORCHAIN=false
# Safety net: true restores the v1 Teleporter card instead of the v2 BridgeCard.
NEXT_PUBLIC_FLAG_LEGACY_UI=false

# MEV capture treasury (deposit-only destinations) + batch-sweep cadence.
# The capture engine DEPOSITS to these addresses; it never holds or spends
# from them (docs/MEV-PAYOUT.md). The addresses are PUBLIC deposit
# destinations — safe to know; the SEEDs/keys live offline with Mr. Esters,
# NEVER in the repo. Unset → the repo defaults (the addresses below) stand.
# Post-cutover Mr. Esters re-derives the addresses from his own offline seed
# and swaps them in here / in the gitignored .sandbox/mev-payout-config.json.
VITE_MEV_PAYOUT_EVM=0xd907e2d4770D3222382eE619980075ac1e59a369
VITE_MEV_PAYOUT_SOLANA_X1=H3JfpvBRxAQ9ejrkyeKtCEy3WSRKbwcCxxxFBcohKSuY
# Batch-sweep cadence: daily | weekly (NOT per-trade — gas amortized per batch).
MEV_SWEEP_FREQUENCY=daily
# The batch-convert basket (comma list; default SOL,wBTC,wETH,USDC).
#MEV_SWEEP_BASKET=SOL,wBTC,wETH,USDC
